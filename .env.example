# ─── Supabase (backend — service key, NUNCA exponerla al frontend) ───────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Usá un string largo y aleatorio (mínimo 32 chars). Ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=un-string-largo-y-aleatorio-minimo-32-chars

# ─── Puerto ───────────────────────────────────────────────────────────────────
PORT=3000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# En desarrollo: http://localhost:5173
# En producción (Railway): URL del frontend en Vercel (sin barra final)
# Se pueden poner varios orígenes separados por coma
CORS_ORIGINS=http://localhost:5173

# ─── Frontend (Vite — claves PÚBLICAS, van al bundle del cliente) ─────────────
# VITE_API_URL: en desarrollo podés omitirlo (el proxy de Vite lo maneja).
# En producción (Vercel) setearlo a la URL completa del backend en Railway:
#   VITE_API_URL=https://snop-backend.railway.app/api
VITE_API_URL=http://localhost:3000/api
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Email (Resend — plan gratuito: 100 emails/día, 3000/mes) ─────────────────
# 1. Creá cuenta en https://resend.com (es gratis, no requiere tarjeta)
# 2. Generá una API Key en Resend → API Keys → Add API Key
# 3. RESEND_FROM:
#    - Sin dominio propio verificado → usá el sandbox de Resend:
#        RESEND_FROM=SNOP Club <onboarding@resend.dev>
#      ATENCIÓN: en sandbox solo podés enviar a la dirección de tu cuenta Resend.
#    - Con dominio propio verificado en Resend (Settings → Domains) podés enviar
#      a cualquier dirección:
#        RESEND_FROM=SNOP Club <noreply@tudominio.com>
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=SNOP Club <onboarding@resend.dev>

# ─── URL pública del frontend ─────────────────────────────────────────────────
# Se usa en los links de los emails (reset password, bienvenida, turno, etc.)
# En desarrollo: http://localhost:5173
# En producción: https://snop-psi.vercel.app
FRONTEND_URL=http://localhost:5173

# ─── Entorno ──────────────────────────────────────────────────────────────────
NODE_ENV=development
