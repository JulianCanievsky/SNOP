# ─── Supabase (backend — service key) ────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=un-string-largo-y-aleatorio-aqui

# ─── CORS ─────────────────────────────────────────────────────────────────────
# En producción (Railway): poner la URL del frontend en Vercel
# Se pueden agregar varios orígenes separados por coma sin espacios
# Ejemplo: CORS_ORIGINS=https://snop-psi.vercel.app,https://www.midominio.com
CORS_ORIGINS=http://localhost:5173

# ─── Frontend (Vite — claves públicas) ───────────────────────────────────────
# En producción (Vercel): setear esta variable con la URL del backend desplegado
# Ejemplo: https://snop-backend.railway.app/api
VITE_API_URL=http://localhost:3000/api
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Email (REQUERIDO en producción para recuperación de contraseña y notificaciones) ──
# Sin RESEND_API_KEY los emails no se envían. En producción el servidor registra el error.
# Obtené tu clave en https://resend.com — el plan gratuito alcanza para desarrollo.
# RESEND_FROM debe ser un dominio verificado en Resend (no se puede usar gmail.com, etc.)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=SNOP Club <noreply@tudominio.com>
# FRONTEND_URL es la URL pública del frontend en producción (se usa en los links de email)
# Ejemplo: https://snop-psi.vercel.app
FRONTEND_URL=http://localhost:5173

# ─── Entorno ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
