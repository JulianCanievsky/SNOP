# ─── Supabase (backend — service key) ────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=un-string-largo-y-aleatorio-aqui

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:5173

# ─── Frontend (Vite — claves públicas) ───────────────────────────────────────
# En producción (Vercel): setear esta variable con la URL del backend desplegado
# Ejemplo: https://snop-backend.railway.app/api
VITE_API_URL=http://localhost:3000/api
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Email (opcional) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=SNOP Club <onboarding@resend.dev>
FRONTEND_URL=http://localhost:5173

# ─── Entorno ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
