# ─── Supabase (backend — service key, NUNCA exponerla al frontend) ───────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Usá un string largo y aleatorio (mínimo 32 chars). Ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=un-string-largo-y-aleatorio-minimo-32-chars

# ─── Puerto ───────────────────────────────────────────────────────────────────
PORT=3000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# En desarrollo: http://localhost:5173
# En producción (Railway): URL del frontend en Vercel (sin barra final)
# Se pueden poner varios orígenes separados por coma
CORS_ORIGINS=http://localhost:5173

# ─── Frontend (Vite — claves PÚBLICAS, van al bundle del cliente) ─────────────
# VITE_API_URL: en desarrollo podés omitirlo (el proxy de Vite lo maneja).
# En producción (Vercel) setearlo a la URL completa del backend en Railway:
#   VITE_API_URL=https://snop-backend.railway.app/api
VITE_API_URL=http://localhost:3000/api
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Email (Brevo — plan gratuito: 300 emails/día, sin dominio propio) ────────
# 1. Creá cuenta en https://app.brevo.com (gratis, sin tarjeta)
# 2. Generá API key: tu nombre → SMTP & API → API Keys → Generate a new API key
# 3. Verificá el email remitente: Senders & IP → Senders → Add a new sender
#    (Brevo manda un email de confirmación al remitente — confirmalo)
# Con eso podés enviar a CUALQUIER destinatario sin necesitar dominio propio.
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_FROM_EMAIL=tu-email-verificado@gmail.com
BREVO_FROM_NAME=SNOP Club

# ─── URL pública del frontend ─────────────────────────────────────────────────
# Se usa en los links de los emails (reset password, bienvenida, turno, etc.)
# En desarrollo: http://localhost:5173
# En producción: https://snop-psi.vercel.app
FRONTEND_URL=http://localhost:5173

# ─── Entorno ──────────────────────────────────────────────────────────────────
NODE_ENV=development
